pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Hello! Jenkins is building.'
            }
        }

        stage('Test') {
            steps {
                echo 'Hello! Jenkins is testing.'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Hello! Jenkins is deploying.'
            }
        }
    }
}